ENVIRONMENT=development

# Supabase (ca-central-1 project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of allowed web origins
ALLOWED_ORIGINS=http://localhost:3000

# Dev/test helpers for curl (not read by the app). Synthetic test clinician only.
SUPABASE_ANON_KEY=
TEST_EMAIL=
TEST_PASSWORD=

# Audit log signing (see core/audit.py for how to generate)
AUDIT_SIGNING_KEY=
AUDIT_KEY_ID=dev-1

# Signs patient link tokens. Empty is fine in development (random per process);
# REQUIRED and must be stable in any other environment.
CHECKIN_LINK_SECRET=

# Public keys of other/past signing keys so their rows stay verifiable, as JSON:
# {"dev-1": "<base64 public key>"}. Not secret. Current key is derived automatically.
AUDIT_PUBLIC_KEYS=

# Where patients open their links (deployed web app origin). Used by the "issue link" endpoint.
# Dev falls back to http://localhost:3000; elsewhere the endpoint returns 503 until set.
WEB_BASE_URL=

# Optional. Per-patient request budgets on link-token routes (in-memory, per instance; 0 = off).
# PATIENT_LINK_READS_PER_MINUTE=60
# PATIENT_LINK_WRITES_PER_MINUTE=10

# Optional. Comma-separated consent types patients may grant. Empty = any well-formed slug
# (the consent list isn't settled yet).
# CONSENT_TYPES=

# Optional. AI via AWS Bedrock in ca-central-1 (core/ai.py; nothing calls it yet).
# Credentials use boto3's standard chain -- set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY as real
# environment variables (Railway), not here: this file is only read into the app's own settings.
# AWS_REGION is ignored on purpose; the Bedrock region is fixed to ca-central-1.
# BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
# Per-clinic calls per UTC day, in-memory per instance. 0 blocks all AI calls (kill switch).
# AI_DAILY_CALL_CAP_PER_CLINIC=200
